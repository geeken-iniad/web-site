<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-6xl px-4 py-4">
    <div
      class="rounded-2xl bg-[#001027]/80 backdrop-blur-md shadow-xl border border-white/10"
    >
      <div
        class="px-6 py-3 text-white font-medium tracking-wide flex items-center justify-between gap-4"
      >
        <!-- <div class="whitespace-nowrap text-lg font-bold tracking-wider">
          情報技術メディア研究会
        </div> -->
        <!-- 左側のグループ（ロゴ＋文字） -->
        <div class="flex items-center gap-3">
          <img
            src="/geeken_logo_white.png"
            alt="GeeKEN Logo"
            class="h-14 w-auto"
          />
          <div class="whitespace-nowrap text-lg font-bold tracking-wider">
            情報技術メディア研究会
          </div>
        </div>
        <nav class="hidden md:flex items-center gap-1">
          <a
            href="#mission"
            class="px-4 py-2 text-sm rounded-lg hover:bg-white/10 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
          >
            Mission
          </a>
          <a
            href="#activities"
            class="px-4 py-2 text-sm rounded-lg hover:bg-white/10 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
          >
            Activities
          </a>
          <a
            href="#contact"
            class="px-4 py-2 text-sm rounded-lg hover:bg-white/10 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
          >
            Contact
          </a>
        </nav>
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center h-10 w-10 rounded-lg hover:bg-white/10 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
          aria-label="メニューを開く"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-50 hidden bg-[#001027]/95 text-white"
  aria-hidden="true"
>
  <div class="h-full w-full px-6 py-6 flex flex-col">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <img
          src="/geeken_logo_white.png"
          alt="GeeKEN Logo"
          class="h-12 w-auto"
        />
        <div class="whitespace-nowrap text-base font-bold tracking-wider">
          情報技術メディア研究会
        </div>
      </div>
      <button
        id="mobile-menu-close"
        type="button"
        class="inline-flex items-center justify-center h-10 w-10 rounded-lg hover:bg-white/10 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
        aria-label="メニューを閉じる"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mt-12 flex flex-col items-center gap-6 text-2xl font-semibold">
      <a
        href="#mission"
        class="mobile-menu-link hover:text-white/70 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
      >
        Mission
      </a>
      <a
        href="#activities"
        class="mobile-menu-link hover:text-white/70 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
      >
        Activities
      </a>
      <a
        href="#contact"
        class="mobile-menu-link hover:text-white/70 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
      >
        Contact
      </a>
    </nav>
  </div>
</div>

<script>
  const menuButton = document.getElementById("mobile-menu-button");
  const menuClose = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");

  const openMenu = () => {
    menu?.classList.remove("hidden");
    menu?.setAttribute("aria-hidden", "false");
    menuButton?.setAttribute("aria-expanded", "true");
    document.body.style.overflow = "hidden";
  };

  const closeMenu = () => {
    menu?.classList.add("hidden");
    menu?.setAttribute("aria-hidden", "true");
    menuButton?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  menuButton?.addEventListener("click", openMenu);
  menuClose?.addEventListener("click", closeMenu);

  document.querySelectorAll(".mobile-menu-link").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>
