---
interface Props {
  qaItems: { q: string; a: string }[];
}

const { qaItems } = Astro.props;
---

<section
  id="faq"
  class="min-h-svh bg-[#0a192f] snap-start py-24 flex items-center"
>
  <div class="mx-auto max-w-4xl px-4 w-full">
    <div class="mb-16">
      <h2
        class="text-4xl md:text-5xl font-bold text-white mb-4 border-b-4 border-white inline-block pb-2"
      >
        よくある質問
      </h2>
    </div>

    <div class="join join-vertical w-full">
      {
        qaItems.map((item, index) => (
          <div class="collapse collapse-arrow join-item border-b border-white/10">
            <input
              type="radio"
              name="my-accordion-4"
              checked={index === 0 ? "checked" : undefined}
            />
            <div class="collapse-title text-xl font-medium text-white py-6">
              {item.q}
            </div>
            <div class="collapse-content text-slate-300">
              <p class="pb-4 leading-relaxed">{item.a}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
