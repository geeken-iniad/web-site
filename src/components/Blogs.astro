---
import { externalArticles } from "../articles/articles";
---

<section id="blog" class="min-h-svh bg-base-200 snap-start py-24 flex items-center">
  <div class="container mx-auto px-4 max-w-5xl w-full">
    <div class="mb-16 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-primary mb-4">Articles</h2>
      <p class="text-slate-600 text-lg">技研部員が記事を書きました！</p>
      <p class="text-slate-600 text-lg">技術のことから大学のことまで</p>
      <p class="text-slate-600 text-lg">ぜひ読んでみてください</p>
    </div>

    <div class="flex justify-center overflow-x-auto snap-x snap-mandatory gap-6 pb-8 px-[7.5%] md:px-[calc((100vw-400px)/2)] [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
      {
        externalArticles.map((article) => (
          <a
            href={article.url}
            target="_blank"
            rel="noopener noreferrer"
            class="snap-center shrink-0 w-[85%] max-w-[400px] card bg-base-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-base-300 overflow-hidden"
          >
            <figure class="h-48 w-full bg-slate-100 border-b border-slate-200">
              <img
                src={article.thumbnail_url || "/geeken_logo_white.png"}
                alt={`${article.title}のサムネイル`}
                class="object-cover w-full h-full"
              />
            </figure>
            <div class="card-body">
              <div class="flex items-center justify-between mb-2">
                <span class="text-sm font-medium text-base-content/80 flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {article.author}
                </span>
                <span class="text-xs text-base-content/70">
                  {article.publishedAt}
                </span>
              </div>

              <h3 class="card-title text-lg leading-snug mt-1">
                {article.title}
              </h3>

              <div class="card-actions justify-end mt-4">
                <span class="text-sm text-primary flex items-center gap-1 font-semibold">
                  記事を読む
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a href="/blogs" class="btn btn-primary btn-outline px-8 w-full sm:w-auto">
        記事一覧を見る
      </a>
    </div>
  </div>
</section>
