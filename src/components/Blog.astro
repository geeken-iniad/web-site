---
interface Props {
  contents: { id: string; title: string }[];
}

const { contents } = Astro.props;
---

<section id="blog" class="hero min-h-svh bg-base-100 snap-start">
  <div class="hero-content flex-col w-full">
    <h2 class="text-4xl font-bold text-primary mb-8">GeeKEN BLOG</h2>
    <div class="w-full max-w-xl">
      <ul class="menu bg-base-200 w-full rounded-box">
        {
          contents.map((content) => (
            <li>
              <a href={content.id} class="text-lg hover:text-primary">
                {content.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
