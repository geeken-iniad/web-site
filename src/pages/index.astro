---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Catchphrase from "../components/Catchphrase.astro";
import Mission from "../components/Mission.astro";

// microCMS呼び出し
import { getBlogs } from "../library/microcms";
const response = await getBlogs({ fields: ["id", "title"] });
const qaItems = [
  {
    q: "サークル費などはかかりますか？",
    a: "一切かかりません。 サークル費や入会費はすべて無料です。",
  },
  {
    q: "プログラミングの知識や経験がなくても大丈夫ですか？",
    a: "はい、大丈夫です。初心者大歓迎ですので、一緒にスキルアップしていきましょう！",
  },
  {
    q: "どのような活動をしていますか？",
    a: "主にゼミ（勉強会）、IT企業見学、ハッカソン参加、技術書典への出展などを行っています。",
  },
  {
    q: "どこで活動していますか？",
    a: "主に2階食堂横のシェアスペースや、キャンパス内の教室で活動しています。その他ハッカソンなどに参加する場合は、オンラインでの活動も行っています。",
  },
];
---

<Layout title="GeeKEN Website">
  <style is:global>
    html,
    body {
      background-color: #0a192f;
      overscroll-behavior-y: none;
    }
  </style>

  <main
    class="h-svh overflow-y-scroll snap-y snap-mandatory scroll-smooth font-sans text-slate-800"
  >
    <Header />
    <Catchphrase />

    <Mission />

    <section
      id="activities"
      class="min-h-svh bg-[#F8FAFC] snap-start py-24 flex items-center"
    >
      <div class="mx-auto max-w-6xl px-4 w-full">
        <div class="text-center mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-[#0a192f] mb-4">
            Activities
          </h2>
          <p class="text-slate-600 text-lg">GeeKENで行っている主な活動内容</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {/* Card 1 */}
          <div
            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-6 group-hover:bg-blue-600 group-hover:text-white transition-colors duration-300"
            >
              <span class="text-3xl">📘</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">ゼミ (勉強会)</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              最近学んだことを持ち寄って発表、共有する勉強会です。一人では学びきれない分野を知る機会をつくります。
            </p>
          </div>

          {/* Card 2 */}
          <div
            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-6 group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-300"
            >
              <span class="text-3xl">🏢</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">IT企業見学</h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              一人ではなかなか行けない実際の開発現場を訪問し、エンジニアの方から直接お話を聞きにいきます
            </p>
          </div>

          {/* Card 3 */}
          <div
            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-sky-50 text-sky-600 flex items-center justify-center mb-6 group-hover:bg-sky-600 group-hover:text-white transition-colors duration-300"
            >
              <span class="text-3xl">💻</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">
              ハッカソン参加
            </h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              チームを組んで短期間でプロダクトを開発するハッカソンというイベントに参加します。技術力とチームワークを磨きます。
            </p>
          </div>

          {/* Card 4 */}
          <div
            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col items-center text-center group"
          >
            <div
              class="w-16 h-16 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center mb-6 group-hover:bg-teal-600 group-hover:text-white transition-colors duration-300"
            >
              <span class="text-3xl">📚</span>
            </div>
            <h3 class="text-xl font-bold text-slate-800 mb-3">
              技術書典へ出展
            </h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              日頃の学習成果を一冊の本にまとめ、技術系イベントでの頒布を目指します。
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      id="faq"
      class="min-h-svh bg-[#0a192f] snap-start py-24 flex items-center"
    >
      <div class="mx-auto max-w-4xl px-4 w-full">
        <div class="mb-16">
          <h2
            class="text-4xl md:text-5xl font-bold text-white mb-4 border-b-4 border-white inline-block pb-2"
          >
            よくある質問
          </h2>
        </div>

        <div class="join join-vertical w-full">
          {
            qaItems.map((item, index) => (
              <div class="collapse collapse-arrow join-item border-b border-white/10">
                <input
                  type="radio"
                  name="my-accordion-4"
                  checked={index === 0 ? "checked" : undefined}
                />
                <div class="collapse-title text-xl font-medium text-white py-6">
                  {item.q}
                </div>
                <div class="collapse-content text-slate-300">
                  <p class="pb-4 leading-relaxed">{item.a}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!--
    <section id="blog" class="hero min-h-svh bg-base-100 snap-start">
      <div class="hero-content flex-col w-full">
        <h2 class="text-4xl font-bold text-primary mb-8">GeeKEN BLOG</h2>
        <div class="w-full max-w-xl">
          <ul class="menu bg-base-200 w-full rounded-box">
            {
              response.contents.map((content: any) => (
                <li>
                  <a href={content.id} class="text-lg hover:text-primary">
                    {content.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
    -->

    <section
      id="contact"
      class="hero min-h-svh bg-[#0a192f] text-white snap-start relative overflow-hidden flex items-center justify-center"
    >
      {/* Background Grid Pattern (統一感のため追加) */}
      <div
        class="pointer-events-none absolute inset-0 opacity-10"
        style="background-image: linear-gradient(to right, #ffffff 1px, transparent 1px), linear-gradient(to bottom, #ffffff 1px, transparent 1px); background-size: 40px 40px;"
      >
      </div>

      <div class="hero-content text-center relative z-10 w-full px-4">
        <div class="max-w-xl mx-auto">
          <h2 class="text-4xl md:text-5xl font-bold mb-8 tracking-wide">
            Contact
          </h2>
          <p class="mb-12 text-slate-400 text-lg">Socials & Links</p>

          <div class="flex justify-center gap-8 md:gap-12">
            {/* X (Twitter) Icon */}
            <a
              href="https://x.com/iniad_geeken"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/5 border border-white/10 hover:bg-black/50 transition-all duration-300 hover:scale-110 hover:shadow-[0_0_30px_rgba(255,255,255,0.2)]"
              aria-label="X (Twitter)"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="36"
                height="36"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="text-slate-300 group-hover:text-white transition-colors duration-300"
              >
                <path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                ></path>
              </svg>
            </a>

            {/* Mail Icon */}
            <a
              href="mailto:geeken-iniad@protonmail.com"
              class="group relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/5 border border-white/10 hover:bg-emerald-900/50 transition-all duration-300 hover:scale-110 hover:shadow-[0_0_30px_rgba(16,185,129,0.3)]"
              aria-label="Email"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="36"
                height="36"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-slate-300 group-hover:text-emerald-400 transition-colors duration-300"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>

            {/* Github Icon */}
            <a
              href="https://github.com/geeken-iniad"
              target="_blank"
              rel="noopener noreferrer"
              class="group relative flex items-center justify-center w-20 h-20 md:w-24 md:h-24 rounded-full bg-white/5 border border-white/10 hover:bg-[#181717]/80 transition-all duration-300 hover:scale-110 hover:shadow-[0_0_30px_rgba(168,85,247,0.3)]"
              aria-label="GitHub"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="36"
                height="36"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-slate-300 group-hover:text-purple-400 transition-colors duration-300"
              >
                <path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                ></path><path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
            </a>
          </div>

          <div class="mt-20 text-xs text-slate-500 font-mono">
            © {new Date().getFullYear()} INIAD GeeKEN. All rights reserved.
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
