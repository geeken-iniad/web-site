---
import Layout from "../layouts/Layout.astro";

// microCMS呼び出し
import { getBlogs } from "../library/microcms";
const response = await getBlogs({ fields: ["id", "title"] });
---

<Layout title="GeeKEN Website">
  <main class="h-svh overflow-y-scroll snap-y snap-mandatory scroll-smooth">
    <header class="fixed top-0 left-0 right-0 z-50">
      <div class="mx-auto max-w-6xl px-4 py-3">
	<div class="rounded-2xl bg-[rgba(0,16,39,0.35)] backdrop-blur-md shadow-lg">
	  <div class="px-5 py-3 text-white font-semibold tracking-wide flex items-center justify-between gap-4">
	    <div class="whitespace-nowrap">情報技術メディア研究会</div>
	    <nav class="flex items-center gap-2">
	      <a
		href="#mission"
		class="btn btn-sm shadow-none border-0 bg-white/10 text-white hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
	      >
		Mission
	      </a>
              <a
		href="#activities"
		class="btn btn-sm shadow-none border-0 bg-white/10 text-white hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
              >
		Activities
              </a>
              <a
		href="#contact"
		class="btn btn-sm shadow-none border-0 bg-white/10 text-white hover:bg-white/10 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/30"
              >
		Contact
              </a>
	    </nav>
	  </div>
	</div>
      </div>
    </header>

    <section id="catchphrase" class="hero min-h-svh bg-[#1E2E47] snap-start">
      {/* Grid overlay */}
      <div
	class="pointer-events-none absolute inset-0 opacity-100 [background-image:linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] [background-size:40px_40px]"
      ></div>
      <div class="hero-content text-center">
        <div class="max-w-md">
          <h2 class="text-5xl text-white font-bold mb-8">
            "やってみたい"<br />をみんなで叶える
          </h2>
          <p class="py-6 text-xl text-gray-300">
            情報技術メディア研究会(INIAD GeeKEN)は<br />
            東洋大学情報連携学部 公認サークルです
          </p>
          <a
            href="#mission"
	    class="btn btn-circle mt-10 animate-bounce border-0 shadow-lg"
	    style="background:#025BC3; color:#fff;"
	    aria-label="次のセクションへ"
	  >
	    {/* chevron-down */}
	    <svg
	      xmlns="http://www.w3.org/2000/svg"
	      viewBox="0 0 24 24"
	      fill="none"
	      stroke="currentColor"
	      stroke-width="2"
	      stroke-linecap="round"
	      stroke-linejoin="round"
	      class="w-6 h-6"
	      aria-hidden="true"
	    >
	      <path d="M6 9l6 6 6-6" />
	    </svg>
	  </a>

        </div>
      </div>
    </section>

    <section id="mission" class="hero min-h-svh bg-[rgba(2,91,195,0.85)] snap-start">
      <div class="hero-content text-center flex-col">
	<div class="max-w-3xl rounded-2xl px-8 py-10 bg-[rgba(0,16,39,0.22)] backdrop-blur-sm">
	  <h2 class="text-4xl font-bold text-white mb-4 tracking-wide">Mission</h2>
	  <p class="text-lg max-w-2xl mx-auto leading-8 text-[rgba(248,250,255,0.92)]">
            ITやコンピュータサイエンスは難しそうで、<br />
            一人で学び続けるには高い壁のある分野です。<br /><br />
            <span class="font-semibold text-white">GeeKEN</span>は、その「<span class="font-semibold text-white">最初の壁</span>」を一緒に越えるための場所です。<br />
            少し詳しい人も、これから始めたい人も、<br />
            ギークの卵同士が出会い、学びあい、<br />
            「面白い」が連鎖していく— そんな空間を目指しています！
	  </p>
	</div>
      </div>
    </section>


    <section id="activities" class="hero min-h-svh bg-[rgb(32,94,168)] snap-start">
      <div class="hero-content flex-col">
        <h2 class="text-4xl font-bold text-accent mb-8">Activities</h2>
        <ul class="steps steps-vertical lg:steps-horizontal">
          <li class="step step-primary">ゼミ(勉強会)</li>
          <li class="step step-primary">IT企業見学</li>
          <li class="step step-primary">ハッカソン参加</li>
          <li class="step step-primary">技術書典へ出展</li>
        </ul>
      </div>
    </section>

    <!--
    <section id="blog" class="hero min-h-svh bg-base-100 snap-start">
      <div class="hero-content flex-col w-full">
        <h2 class="text-4xl font-bold text-primary mb-8">GeeKEN BLOG</h2>
        <div class="w-full max-w-xl">
          <ul class="menu bg-base-200 w-full rounded-box">
            {
              response.contents.map((content: any) => (
                <li>
                  <a href={content.id} class="text-lg hover:text-primary">
                    {content.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
    -->

    <section
      id="contact"
      class="hero min-h-svh bg-neutral text-neutral-content snap-start">
      <div class="hero-content text-center">
        <div class="max-w-md">
          <h2 class="text-3xl font-bold mb-6">Contact</h2>
          <p class="mb-4">Socials & Links</p>
          <div class="flex justify-center gap-6">
            <a
              href="https://x.com/iniad_geeken"
              class="btn btn-circle btn-ghost text-2xl">X</a
            >
            <a
              href="mailto:geeken-iniad@protonmail.com"
              class="btn btn-circle btn-ghost text-2xl">✉</a
            >
            <a
              href="https://github.com/geeken-iniad"
              class="btn btn-circle btn-ghost text-2xl">Git</a
            >
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
