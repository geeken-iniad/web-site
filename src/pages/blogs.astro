---
// src/pages/blogs.astro

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro"; 
import { externalArticles } from "../articles/articles";
---

<Layout title="Articles | GeeKEN">
  <style is:global>
    html,
    body {
      background-color: #0a192f;
    }
  </style>

  <main class="scroll-smooth font-sans text-slate-800 bg-[#F8FAFC]">
    <Header />

    <section class="pt-24 pb-12 px-4 min-h-svh">
      <div class="container mx-auto max-w-5xl">
        
        <div class="mb-12">
          <a href="/" class="btn btn-ghost mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            トップへ戻る
          </a>
          <h1 class="text-4xl md:text-5xl font-bold text-[#0a192f] mb-4">Articles</h1>
          <p class="text-slate-600 text-lg">GeeKENメンバーが執筆した技術記事の一覧です。</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            externalArticles.map((article) => (
              <a 
                href={article.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="card bg-white shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 border border-slate-200 overflow-hidden"
              >
                <figure class="h-48 w-full bg-slate-100 border-b border-slate-200">
                  <img
                    src={article.thumbnail_url || "/geeken_logo_white.png"}
                    alt={`${article.title}のサムネイル`}
                    class="object-cover w-full h-full"
                  />
                </figure>

                <div class="card-body p-6">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-medium text-slate-600 flex items-center gap-1">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                      {article.author}
                    </span>
                    
                    <span class="text-xs text-slate-400">
                      {article.publishedAt}
                    </span>
                  </div>
                  
                  <h3 class="card-title text-xl text-slate-800 leading-snug mt-1">
                    {article.title}
                  </h3>
                  
                  <div class="card-actions justify-end mt-4">
                    <span class="text-sm text-blue-600 flex items-center gap-1 font-semibold">
                      記事を読む
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>

      </div>
    </section>
  </main>
</Layout>
